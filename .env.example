# CAFA PMIS local development template — names and placeholders only.
# Copy to .env.local. Never place staging or production values in this repository.
# For the AWS task contract, use .env.production.example and the AWS runbook.

# ─── Runtime / database ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://<LOCAL_DB_USER>:<LOCAL_DB_PASSWORD>@<LOCAL_DB_HOST>:<LOCAL_DB_PORT>/<LOCAL_DB_NAME>
RUN_MIGRATIONS_ON_STARTUP=true
SCHEDULER_ENABLED=false

# ─── Session / browser origin ─────────────────────────────────────────────────
# Use a locally generated random value. Production requires a unique secret per
# environment and rejects a missing value.
SESSION_SECRET=<GENERATE_A_LOCAL_RANDOM_SECRET>
PUBLIC_APP_URL=http://localhost:8080

# ─── Explicit local S3-compatible storage ─────────────────────────────────────
# The selected production provider is private AWS S3. For local development,
# use a private development bucket or an explicitly configured emulator. Keep
# provider credentials outside this file (for example, the AWS SDK profile/role
# chain). Production requires S3_BUCKET and S3_REGION.
STORAGE_PROVIDER=s3
S3_BUCKET=<LOCAL_PRIVATE_BUCKET>
S3_REGION=<LOCAL_REGION>
S3_ENDPOINT_URL=<OPTIONAL_LOCAL_S3_ENDPOINT>
S3_PUBLIC_PREFIX=public
S3_PRIVATE_PREFIX=objects
MAX_ATTACHMENT_SIZE_MB=25

# ─── Email (disabled by default) ──────────────────────────────────────────────
# Stub mode records/logs attempts and sends no mail. Do not enable real delivery
# unless a local sandbox is explicitly approved.
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@localhost.invalid
EMAIL_FROM_NAME=CAFA Program Management System
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_API_KEY=

# ─── Optional AI assistant ────────────────────────────────────────────────────
AI_ENABLED=false
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# ─── Non-production test controls ─────────────────────────────────────────────
# Never set these in a deployed service. The fixture commands also refuse
# NODE_ENV=production.
# CAFA_DEMO_MODE=true
# E2E_ENABLE_NON_PRODUCTION_FIXTURES=true
# E2E_BASE_URL=http://localhost:8080
# E2E_USERNAME=<ISOLATED_TEST_USER>
# E2E_PASSWORD=<ISOLATED_TEST_PASSWORD>
