# ═══════════════════════════════════════════════════════════════════════════════
# CAFA PMIS — AWS ECS production environment variable names
#
# This is a name-only template for the ECS task definition and Secrets Manager.
# Do not copy production secrets to a repository file, image, task-definition
# plaintext, shell history, or browser. See docs/aws-deployment-runbook.md.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Node runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Server port (inside the ECS task; ALB maps public HTTPS) ───────────────────
PORT=8080

# ── Database ──────────────────────────────────────────────────────────────── ✅
# Secrets Manager reference: private, environment-specific RDS PostgreSQL URL.
DATABASE_URL=postgres://<USER>:<PASSWORD>@<RDS_PRIVATE_ENDPOINT>:5432/<DATABASE>

# Production API verifies this tracked migration head but never applies it.
# Run the one-shot migration release job before each API rollout.
RUN_MIGRATIONS_ON_STARTUP=false
# Initial approved topology is exactly one API replica and one scheduler owner.
SCHEDULER_ENABLED=true

# ── Session security ─────────────────────────────────────────────────────── ✅
# Secrets Manager reference. Use a distinct value for each environment.
SESSION_SECRET=<SECRET_MANAGER_REFERENCE>

# ── CORS / public URL ────────────────────────────────────────────────────── ✅
# Exact HTTPS origin users reach in this environment. Used for credentialed CORS
# and email links. No path, query, credentials, or wildcard.
PUBLIC_APP_URL=https://<PRODUCTION_ORIGIN>

# ── Static file serving ──────────────────────────────────────────────────────
# Path inside the container where the compiled Vite frontend lives.
# Set by the Dockerfile — do not change unless you change the build.
STATIC_FILES_PATH=/app/public

# ═══════════════════════════════════════════════════════════════════════════════
# File Storage — AWS S3 production contract
# ═══════════════════════════════════════════════════════════════════════════════
#
# Use a private, production-only bucket. The API is the only object-data path: uploads are
# signed by the backend, then registered only after parent-authorised metadata
# verification. Browsers receive authenticated proxy responses, not bucket
# credentials or raw object identities.
#
# Credentials are intentionally not listed here. The AWS SDK default provider
# chain is used; prefer an attached IAM role/workload identity over static
# access keys. If static credentials are unavoidable, inject them only into
# the backend runtime secret store.
STORAGE_PROVIDER=s3
S3_BUCKET=<PRODUCTION_PRIVATE_BUCKET>
S3_REGION=<AWS_REGION>

# Omit for standard AWS S3. Set only for an explicitly selected S3-compatible
# staging endpoint (for example, a local emulator or R2).
S3_ENDPOINT_URL=
S3_PUBLIC_PREFIX=public
S3_PRIVATE_PREFIX=objects

# ═══════════════════════════════════════════════════════════════════════════════
# Email  (optional — stub mode records/logs delivery attempts when disabled)
# ═══════════════════════════════════════════════════════════════════════════════

# Keep false until sender/domain approval and delivery policy are in place.
EMAIL_ENABLED=false

# Provider: smtp | resend | sendgrid
EMAIL_PROVIDER=smtp

# ── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=<SECRET_MANAGER_REFERENCE>

# ── Resend / SendGrid API (alternative to SMTP) ───────────────────────────────
# EMAIL_PROVIDER=sendgrid
# EMAIL_API_KEY=<SECRET_MANAGER_REFERENCE>

# Sender identity used by all enabled providers.
EMAIL_FROM_ADDRESS=no-reply@<PRODUCTION_ORIGIN_DOMAIN>
EMAIL_FROM_NAME=CAFA Program Management System
EMAIL_REPLY_TO=

# ═══════════════════════════════════════════════════════════════════════════════
# AI Assistant  (optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Required only if the AI chat widget is enabled in admin settings. Configure
# through the approved AI integration secret/endpoint references.
AI_ENABLED=false
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ── Operational configuration ───────────────────────────────────────────────
MAX_ATTACHMENT_SIZE_MB=25
LOG_LEVEL=info

# Historical source-import settings are intentionally omitted. They are
# exceptional, source-read-only credentials/configuration and must be injected
# only for an approved import; see docs/aws-deployment-runbook.md.
